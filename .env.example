# Copy to .env (gitignored) — never commit real values.
# Server-only values are pushed to Supabase Edge Function secrets by `node scripts/sync-secrets.mjs`.

# --- Supabase (Project Settings → API) ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PROJECT_REF=<project-ref>
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...      # browser-safe (RLS protects data); also used by web/.env.local
SUPABASE_SECRET_KEY=sb_secret_...                # SERVER ONLY → Edge secret RADAR_SECRET_KEY; local ops scripts

# --- TMDB (free; themoviedb.org → Settings → API → "API Read Access Token") ---
TMDB_READ_TOKEN=eyJ...

# --- Streaming Availability via RapidAPI (free BASIC plan must be subscribed for the key to work) ---
RAPIDAPI_KEY=

# --- Gemini (Google AI Studio API key) ---
GEMINI_API_KEY=
GEMINI_API_KEY_FALLBACK=                         # optional second key, tried on 401/403/429
GEMINI_MODEL=gemini-3.1-flash-lite               # fast default; gemini-3.8-flash is the automatic fallback model

# --- Telegram (BotFather token; bot must be admin with "Post messages" in the channel) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=-100...

# --- Operations ---
CRON_SECRET=                                     # generated by scripts/sync-secrets.mjs if empty (≥ 32 chars)
LIVE_SEND_ENABLED=false                          # scheduled Telegram sends stay OFF until the owner approves
DASHBOARD_URL=https://<your-vercel-app>.vercel.app
